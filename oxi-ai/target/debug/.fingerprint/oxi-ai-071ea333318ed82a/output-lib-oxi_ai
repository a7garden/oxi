lf>`.\n"},"level":"error","spans":[{"file_name":"src/providers/mod.rs","byte_start":967,"byte_end":975,"line_start":32,"line_end":32,"column_start":75,"column_end":83,"is_primary":true,"text":[{"text":"        create: Box::new(|| Box::new(AnthropicProvider::new()) as Box<dyn Provider>),","highlight_start":75,"highlight_end":83}],"label":"`Provider` is not dyn compatible","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"for a trait to be dyn compatible it needs to allow building a vtable\nfor more information, visit <https://doc.rust-lang.org/reference/items/traits.html#dyn-compatibility>","code":null,"level":"note","spans":[{"file_name":"src/providers/trait_def.rs","byte_start":321,"byte_end":329,"line_start":13,"line_end":13,"column_start":11,"column_end":19,"is_primary":false,"text":[{"text":"pub trait Provider: Send + Sync + 'static {","highlight_start":11,"highlight_end":19}],"label":"this trait is not dyn compatible...","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"src/providers/trait_def.rs","byte_start":537,"byte_end":577,"line_start":20,"line_end":20,"column_start":17,"column_end":57,"is_primary":true,"text":[{"text":"    ) -> Result<impl Stream<Item = ProviderEvent> + Send, ProviderError>;","highlight_start":17,"highlight_end":57}],"label":"...because method `stream` references an `impl Trait` type in its return type","suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"src/providers/trait_def.rs","byte_start":537,"byte_end":577,"line_start":20,"line_end":20,"column_start":17,"column_end":57,"is_primary":false,"text":[{"text":"    ) -> Result<impl Stream<Item = ProviderEvent> + Send, ProviderError>;","highlight_start":17,"highlight_end":57}],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":null},"macro_decl_name":"desugaring of `impl Trait`","def_site_span":{"file_name":"src/lib.